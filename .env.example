# HubSales Group — bot de reclutamiento
# Copiar como .env:  cp .env.example .env
# NUNCA subir el .env a GitHub.

# ── Identidad ─────────────────────────────────────────────
# Opcional: cambia el nombre que aparece en el saludo.
# BOT_NAME=Sofía

# ── Formulario obligatorio ────────────────────────────────
# Link obligatorio del formulario. Tiene prioridad sobre config/business.yaml.
# En Coolify se agrega como variable de entorno, sin tocar archivos.
FORM_LINK=https://forms.gle/dW6Dj8XXJhzhZims7

# ── Cerebro con IA (OpenRouter) ──────────────────────────
# Sin estos valores el bot responde con textos fijos; con ellos, usa un LLM.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Tope bajo a propósito: el saldo de OpenRouter se mide en tokens.
OPENROUTER_MAX_TOKENS=700
# IA_MODO=determinista   # fuerza los textos fijos (útil para pruebas)

# ── Proveedor de WhatsApp ─────────────────────────────────
# Opciones: zernio | mock
WHATSAPP_PROVIDER=zernio

# Misma cuenta de Zernio que el bot de Toyota, con OTRO número.
# La API key se reutiliza; el accountId del número nuevo llega en el webhook.
ZERNIO_API_KEY=
# IMPORTANTE: distinto del secreto del bot de Toyota.
ZERNIO_WEBHOOK_SECRET=
# Necesario para el chequeo al arrancar Y para filtrar el webhook solo a este número.
ZERNIO_ACCOUNT_ID=
# Opcional: default https://zernio.com/api/v1
# ZERNIO_BASE_URL=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
# development | production
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local. En Coolify usar un volumen o PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./hubsales.db
# Producción:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
